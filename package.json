{
  "name": "flowpaint-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Flowpaint Studio - a stylus-first 2D liquid painting app (WebGPU + WASM + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "build:wasm": "asc wasm/assembly/index.ts --outFile src/wasm/imgproc.wasm --optimize --runtime stub --noAssert --initialMemory 32",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.60",
    "assemblyscript": "^0.28.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
